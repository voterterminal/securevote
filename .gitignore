# ==========================================
# VoteTerminal — .gitignore
# ==========================================

# Environment / secrets — NEVER commit these
.env
.env.*
!.env.example

# Operational docs — contain server IPs, usernames, internal runbooks
DEPLOY.md
REDEPLOY.md
UPGRADE-*.md
CATCH_UP_NOTES.md
apache-voterterminal.conf
tenants-ssl.conf
post-deploy.sh
create-tenant.sh
manage-tenants.sh
affidavits.*.json
voter_roll*.csv
election_roster.csv
gdems_control
gdems_control/

# Internal / enterprise docs — stay on local machine only
enterprise/
TENANT_OPERATIONS.docx
TECHNICAL_MANUAL.docx
VoteTerminal_Project_Brief.docx
VoterTerminal_v1.0_Release_Notes.docx
USER_MANUAL.docx

# Org-specific files — never commit
GCDP_Election_Checklist.pdf
*.Election_Checklist.pdf

# Corporate SaaS landing page — not part of community edition
landing/

# Internal / not needed for community install
ADVANCED_FEATURES.md
DOCUMENTATION.md
QUICK_START.md
PROJECT_OVERVIEW.md
voter-term.png

# SaaS-only files (not part of community edition)
tenant-server.js
stripe-setup.js
migrate-from-tenants-json.js
email-service.js
export-data.js
import-data.js
admin-preview.html
voting-preview.html
docker/apache-wildcard.conf
docker/nginx.conf
github-release/

# Old server versions
voting-app-server-v*.js
voting-app-server.sync-conflict-*.js

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
build/
dist/
*.tsbuildinfo

# pm2
.pm2/

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V5
.Trashes
ehthumbs.db
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs/
*.log

# SSL certs (managed by certbot on server)
*.pem
*.key
*.crt
*.csr

# Sync conflict files
*.sync-conflict-*

# Test output
coverage/
.nyc_output/

# Temp
tmp/
temp/
