# ==========================================
# SECUREVOTE COMMUNITY EDITION — ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Need hosted/managed deployment? See https://voterterminal.com
# ==========================================


# ==========================================
# CORE SETTINGS (required)
# ==========================================

NODE_ENV=production
PORT=3001

# Public URL of your voting app — used in invite emails so voters get a clickable link.
# No trailing slash.  Example: https://vote.yourdomain.com
APP_URL=https://vote.yourdomain.com

JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
EMERGENCY_PASSWORD=change-this-to-a-secure-emergency-password


# ==========================================
# DATABASE
# ==========================================
# Without DATABASE_URL the server runs in DEMO MODE — data wipes on every restart.
# Set it to any PostgreSQL-compatible connection string for persistent storage.
#
# ── Option A: Supabase (recommended for most users — free tier) ──────────────
#   1. Create a free project at https://supabase.com
#   2. Settings → Database → Connection string → Session mode (port 5432)
#   3. Paste the URI below
#   4. Run:  node migrate.js   (creates all tables — safe to re-run)
#
# ── Option B: Railway ────────────────────────────────────────────────────────
#   Managed PostgreSQL, free hobby tier.  https://railway.app
#   Copy the connection string from your Railway project dashboard.
#
# ── Option C: Neon ───────────────────────────────────────────────────────────
#   Serverless PostgreSQL, generous free tier.  https://neon.tech
#   Copy the connection string from your Neon project dashboard.
#
# ── Option D: Self-hosted PostgreSQL ─────────────────────────────────────────
#   DATABASE_URL=postgres://username:password@localhost:5432/securevote
#   Also uncomment DATABASE_SSL=false below.
#
# ── Option E: Any other PostgreSQL-compatible DB ─────────────────────────────
#   CockroachDB, Timescale, etc. — paste the standard postgres:// URI.

DATABASE_URL=

# Uncomment if your database does not use SSL (e.g. local installs):
# DATABASE_SSL=false


# ==========================================
# ADMIN CREDENTIALS
# ==========================================
# These create the default admin account on first startup.
# Change the password here or via /admin → Settings after setup.

ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=changeme123


# ==========================================
# ORG BRANDING
# ==========================================

ORG_NAME=My Organization
ORG_TAGLINE=Official Ballot
ORG_BANNER_COLOR=#003087
ORG_LOGO_URL=


# ==========================================
# EMAIL PROVIDER
# ==========================================
# Choose one provider below and set EMAIL_PROVIDER to match.
#
#   resend    — recommended, free tier covers most elections
#   smtp      — any SMTP server (Mailgun, Postmark, Brevo, self-hosted)
#   sendgrid  — SendGrid API
#   ses       — Amazon SES via SMTP
#   console   — prints emails to terminal only (good for local dev/testing)

EMAIL_PROVIDER=console

EMAIL_FROM=elections@yourdomain.com
EMAIL_FROM_NAME=SecureVote


# ------------------------------------------
# Resend (recommended)
# ------------------------------------------
# Free tier: 3,000 emails/month, 100/day — enough for most elections.
# Sign up → add your domain → create an API key → paste it below.
# https://resend.com

RESEND_API_KEY=re_your_api_key_here


# ------------------------------------------
# SMTP — works with any provider
# ------------------------------------------
# Brevo:    SMTP_HOST=smtp-relay.brevo.com    SMTP_PORT=587  (300/day free)
# Mailgun:  SMTP_HOST=smtp.mailgun.org        SMTP_PORT=587
# Postmark: SMTP_HOST=smtp.postmarkapp.com    SMTP_PORT=587

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false       # true = TLS port 465 | false = STARTTLS port 587
SMTP_USER=
SMTP_PASS=


# ------------------------------------------
# SendGrid
# ------------------------------------------
# Free: 100 emails/day.  https://app.sendgrid.com/settings/api_keys

SENDGRID_API_KEY=


# ------------------------------------------
# Amazon SES
# ------------------------------------------
# ~$0.10 per 1,000 emails — best for high volume.
# Use SES SMTP credentials (not your IAM key):
# AWS Console → SES → SMTP settings → Create SMTP credentials

SES_SMTP_USER=
SES_SMTP_PASS=
SES_REGION=us-east-1


# ==========================================
# AFFIDAVIT TEMPLATES (optional)
# ==========================================
# Path to a JSON file with custom oath templates.
# Format: array of { id, name, text } objects.
# Leave blank to use the built-in Standard Voter Affidavit only.
# Example: AFFIDAVIT_TEMPLATES_FILE=./affidavits.myorg.json

AFFIDAVIT_TEMPLATES_FILE=


# ==========================================
# DNS RECORDS — required for email delivery
# ==========================================
# Add SPF + DKIM records for your sending domain.
# Your email provider's dashboard will give you the exact DNS values.
# Without them, voter invite emails will land in spam.
# ==========================================
